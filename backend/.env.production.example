# Copy to a secret manager or deployment environment; never commit the filled file.
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require
ACCESS_TOKEN_SECRET=<GENERATE_WITH_A_CSPRNG_AND_STORE_IN_SECRET_MANAGER>
REFRESH_TOKEN_SECRET=<GENERATE_A_DIFFERENT_CSPRNG_SECRET>
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
FRONTEND_URLS=https://app.<YOUR_DOMAIN>
# Optional first-run admin bootstrap. Store these only in a secret manager.
# ADMIN_EMAIL=admin@<YOUR_DOMAIN>
# ADMIN_PASSWORD=<A_RANDOM_PASSWORD_OF_AT_LEAST_8_CHARACTERS>
RATE_LIMIT_PER_MINUTE=60
PROMETHEUS_ENABLED=false
