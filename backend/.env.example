DATABASE_URL=postgresql://postgres:postgres@localhost:5433/locationtrack
PORT=5000
NODE_ENV=development
ACCESS_TOKEN_SECRET=replace-with-a-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
# For production use FRONTEND_URLS=https://app.example.com,https://admin.example.com
# Optional initial admin bootstrap; configure both values.
# An existing email is left unchanged, including its role.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=<A_RANDOM_PASSWORD_OF_AT_LEAST_8_CHARACTERS>
RATE_LIMIT_PER_MINUTE=60
